{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest", "--headless"]
    },
    "vercel": {
      "type": "http",
      "url": "https://mcp.vercel.com"
    },
    "airtable": {
      "type": "http",
      "url": "https://mcp.airtable.com/mcp"
    },
    "search-console": {
      "command": "npx",
      "args": ["-y", "mcp-server-gsc@0.3.0"],
      "env": {
        "GOOGLE_APPLICATION_CREDENTIALS": "${GSC_CREDENTIALS_FILE:-}"
      }
    }
  }
}
