// Cloudflare Workers static site (Vercel Hobby paused Nov 20, 2026). Build command: python3 tools/build_cf.py
// dist/ holds only the public files plus _redirects and _headers generated from vercel.json (see tools/build_cf.py).
{
  "name": "plainstats",
  // only /api/* runs this script (social cards and Airtable deals); every other path is a static file and never counts as a request
  "main": "cf/worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": false,
  // plainstatsnfl.com redirects to www with a zone Redirect Rule; both need to be on the Worker so Cloudflare answers them
  "routes": [
    { "pattern": "www.plainstatsnfl.com", "custom_domain": true },
    { "pattern": "plainstatsnfl.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/scores", "/standings", "/projections", "/news", "/news/*", "/team-ratings", "/team-tiers", "/usage-risers", "/usage-risers/fallers", "/usage-risers/all-players", "/cap-room", "/power-rankings", "/awards", "/player-ratings", "/player-ratings/roles", "/player-ratings/pay-vs-play", "/player-ratings/rankings", "/player-ratings/traits", "/stats", "/contracts", "/best-worst-contracts", "/rookie-contracts", "/free-agency", "/free-agency/key-dates", "/cap-lab", "/big-board", "/mock-draft", "/rookie-pay", "/draft-guide", "/roster-builder", "/trade-checker", "/trade-deadline", "/compare", "/cap-101", "/about", "/search", "/setup", "/team/*", "/team-ratings/best", "/team-ratings/traits", "/team-ratings/roster-ratings", "/team-tiers/offense-vs-defense", "/team-tiers/all-teams", "/awards/how-it-works", "/power-rankings/results-vs-roster", "/power-rankings/risers-and-fallers", "/power-rankings/how-it-works", "/standings/playoff-seeds", "/projections/playoff-odds", "/projections/all-teams", "/projections/how-it-works", "/contracts/position-market", "/contracts/all-players", "/best-worst-contracts/teams", "/best-worst-contracts/all", "/rookie-contracts/extension-watch", "/rookie-contracts/all", "/cap-lab/spending-heatmap", "/cap-lab/cap-health", "/cap-lab/doppelganger", "/free-agency/by-position", "/free-agency/by-team", "/free-agency/all", "/free-agency/franchise-tags", "/free-agency/news", "/big-board/class-depth", "/big-board/expert-splits", "/big-board/full", "/mock-draft/pick-owners", "/rookie-pay/savings", "/rookie-pay/rules", "/player/*", "/prospect/*", "/game/*", "/links", "/links/instagram", "/links/tiktok", "/links/facebook"],  // generated by tools/build_cf.py from vercel.json
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
