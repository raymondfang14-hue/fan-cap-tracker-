{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'; base-uri 'self'; object-src 'none'; form-action 'self' https:"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "fan-cap-tracker.vercel.app"
        }
      ],
      "destination": "https://www.plainstatsnfl.com/:path*",
      "permanent": true
    },
    {
      "source": "/ig",
      "destination": "/links/instagram?utm_source=instagram&utm_medium=social&utm_campaign=bio",
      "permanent": false
    },
    {
      "source": "/tt",
      "destination": "/links/tiktok?utm_source=tiktok&utm_medium=social&utm_campaign=bio",
      "permanent": false
    },
    {
      "source": "/ig/:path*",
      "destination": "/:path*?utm_source=instagram&utm_medium=social&utm_campaign=post",
      "permanent": false
    },
    {
      "source": "/tt/:path*",
      "destination": "/:path*?utm_source=tiktok&utm_medium=social&utm_campaign=post",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/:path((?!api/|data/|assets/|og-data/|_vercel/).*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*([Bb]ot|[Cc]rawler|[Ss]pider|facebookexternalhit|WhatsApp|Embedly|Slurp|Pinterest|vkShare|Iframely|Quora Link Preview).*"
        }
      ],
      "destination": "/api/page?p=/:path"
    },
    {
      "source": "/scores",
      "destination": "/"
    },
    {
      "source": "/standings",
      "destination": "/"
    },
    {
      "source": "/projections",
      "destination": "/"
    },
